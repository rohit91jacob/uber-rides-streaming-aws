# Copy to .env and adjust. Every setting has a safe default (src/uber_rides/config.py).
# Read by the Makefile. No secrets are needed: every source is public and AWS is emulated.

# ---------------------------------------------------------------- storage
UBER_DATA_DIR=./data
# Iceberg warehouse: default <data>/warehouse; s3://bucket/warehouse with UBER_CATALOG_TYPE=glue on AWS
# UBER_WAREHOUSE=
# sql (SQLite, local stand-in for Glue) | glue
UBER_CATALOG_TYPE=sql
UBER_NAMESPACE=uber_lake
UBER_DUCKDB_MEMORY_LIMIT=4GB

# ---------------------------------------------------------------- sources
# A directory holding fhvhv_tripdata_YYYY-MM.parquet / taxi_zone_lookup.csv already (skips the download)
# UBER_TLC_SOURCE_DIR=
UBER_LICENSE_NUM=HV0003
UBER_HTTP_TIMEOUT_SECONDS=120
UBER_HTTP_RETRIES=5

# ---------------------------------------------------------------- AWS (emulated)
# moto (in-process, default) | endpoint (LocalStack / moto_server) | aws (real account; resources from infra/)
UBER_AWS_MODE=moto
# UBER_AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
UBER_KINESIS_STREAM=uber-ride-events
UBER_KINESIS_SHARDS=2
UBER_DEDUPE_TABLE=uber-ride-event-dedupe
UBER_COUNTERS_TABLE=uber-zone-supply-demand
UBER_DLQ_QUEUE=uber-ride-events-dlq
UBER_LANDING_BUCKET=uber-rides-landing
UBER_COUNTER_WINDOW_MINUTES=15

# ---------------------------------------------------------------- streaming replay
# 0 = as fast as possible; 60 = one hour of events per minute
UBER_REPLAY_SPEEDUP=0
UBER_CONSUMER_BATCH_SIZE=500

# ---------------------------------------------------------------- batch / observability
UBER_DQ_FAIL_ON_ERROR=true
# dev | ci | athena
DBT_TARGET=dev
UBER_LOG_LEVEL=INFO
# json | text
UBER_LOG_FORMAT=json
